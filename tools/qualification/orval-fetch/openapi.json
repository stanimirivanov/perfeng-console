      "Error": {
        "$ref": "#/components/schemas/Error/$defs/ErrorDetail",
        "$defs": {
          "ErrorDetail": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
