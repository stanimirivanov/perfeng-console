{
  "openapi": "3.1.0",
  "info": {
    "title": "Nested reference repro",
    "version": "1"
  },
  "paths": {
    "/items": {
      "get": {
        "operationId": "getItems",
        "responses": {
          "400": {
            "description": "Bad request",
