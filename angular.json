{
  "version": 1,
  "projects": {
    "console": {
      "projectType": "application",
      "root": "apps/console",
      "sourceRoot": "apps/console/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/console/src/main.ts",
            "index": "apps/console/src/index.html",
            "tsConfig": "apps/console/tsconfig.app.json",
            "outputPath": "dist/apps/console",
            "styles": [
              "apps/console/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "outputHashing": "all"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "console:build",
            "tsConfig": "apps/console/tsconfig.spec.json",
            "include": ["**/*.spec.ts"],
            "runnerConfig": "apps/console/vitest.config.mts"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "console:build",
            "host": "127.0.0.1",
            "port": 4300
          }
        }
      }
    }
  }
}
